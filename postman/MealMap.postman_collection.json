                  "pm.test('Crea el usuario con rol USER', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "  pm.expect(json.role).to.eql('USER');",
                  "});",
                  "pm.test('No expone la contraseña', () => pm.expect(pm.response.json()).to.not.have.property('password'));"
