{
  "info": {
    "name": "MealMap API",
    "description": "Pruebas de la API de MealMap (Auth, 2FA, logout y seed). Ejecútala completa con el Collection Runner, en orden, usando el entorno \"MealMap - Local\". Antes: docker compose up -d y npm run start:dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Seed",
      "description": "Carga los datos iniciales (idempotente). Requiere el header x-seed-key.",
      "item": [
        {
          "name": "POST /seed - cargar datos iniciales",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "seed"
              ]
            },
            "description": "Crea categorías, ingredientes, recetas y el usuario admin. Se puede repetir sin duplicar."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({ key: 'x-seed-key', value: pm.environment.get('seedKey') });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve el resumen de lo cargado', () => {",
                  "  pm.expect(pm.response.json()).to.have.all.keys('categories', 'ingredients', 'recipes', 'admin');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /seed - sin llave (403)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "seed"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403 sin x-seed-key', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
