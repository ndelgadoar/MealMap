        {
          "name": "POST /auth/login - administrador del seed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function decodeJwt(token) {",
                  "  const CryptoJS = require('crypto-js');",
                  "  let part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  while (part.length % 4) part += '=';",
                  "  return JSON.parse(CryptoJS.enc.Base64.parse(part).toString(CryptoJS.enc.Utf8));",
                  "}",
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('El token trae rol ADMIN', () => {",
                  "  const payload = decodeJwt(pm.response.json().accessToken);",
                  "  pm.expect(payload.role).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
