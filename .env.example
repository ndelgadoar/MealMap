# Copia este archivo a .env y ajusta los valores
# (.env no se sube a git)

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5442
DB_USER=mealmap
DB_PASSWORD=mealmap_dev
DB_NAME=mealmap

# Entorno (development | production)
NODE_ENV=development

# JWT (usa un secreto largo y aleatorio en .env; nunca lo subas a git)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN_SECONDS=3600

# Seed: llave para llamar a POST /seed (header x-seed-key) y credenciales del admin inicial
# Cambia SEED_KEY y ADMIN_PASSWORD por valores propios, sobre todo en producción
SEED_KEY=cambia-esta-llave-del-seed
ADMIN_EMAIL=admin@mealmap.com
ADMIN_PASSWORD=Admin12345!
